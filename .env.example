# Timezone Configuration (WIB)
TZ=Asia/Jakarta

# Active Machine Registry (Comma-separated list, e.g. D1,D10 or D1,D2,D3,...,D20)
ENABLED_MACHINES=D1,D10

# MQTT Configuration
MQTT_BROKER=mqtt://10.11.11.200
MQTT_PORT=1883

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=project_utility

# Web Server Optional Toggle (false = pure DB daemon)
ENABLE_WEB_SERVER=false
